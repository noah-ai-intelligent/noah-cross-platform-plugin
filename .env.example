# Base URL for the Noah API backend
VITE_NOAH_API_URL=https://noah-plugin.example.com/api/v1

# The redirect URI used for OAuth/Login flows. 
# During local development with Vite, this needs to point to the source location:
# VITE_NOAH_REDIRECT_URI=https://localhost:5175/src/login/login.html
# 
# In production, this can be set to the hosted location (or left unset to rely on fallback logic):
# VITE_NOAH_REDIRECT_URI=https://noah-office.example.com/login/login.html
