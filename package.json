{
  "name": "noah-office-addin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "office-addin-debugging start manifest.xml",
    "dev-server": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "validate": "office-addin-manifest validate manifest.xml",
    "sideload": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.470",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "office-addin-debugging": "^5.1.6",
    "office-addin-dev-certs": "^1.13.3",
    "office-addin-manifest": "^1.13.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
