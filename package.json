{
  "name": "noah-office-addin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-manifest.js development",
    "dev": "office-addin-debugging start manifest.xml",
    "dev-server": "npm run predev && vite",
    "prebuild": "node scripts/build-manifest.js production",
    "build": "tsc -b && vite build",
    "prebuild:google": "node scripts/build-manifest.js production",
    "build:google": "tsc -b && GOOGLE=true vite build",
    "deploy:google": "npm run build:google && cp dist/src/taskpane/index.html google/index.html && cd google && clasp push",
    "preview": "vite preview",
    "prevalidate": "node scripts/build-manifest.js development",
    "validate": "office-addin-manifest validate manifest.xml",
    "presideload": "npm run predev",
    "sideload": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/office-js": "^1.0.470",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "office-addin-debugging": "^5.1.6",
    "office-addin-dev-certs": "^1.13.3",
    "office-addin-manifest": "^1.13.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
